# QuotaBar 环境变量示例
# 复制此文件为 .env 并填入真实值（.env 已加入 .gitignore，不会被提交）

# ⚠️ 以下仅为占位示例，真实凭证请通过 App 内设置界面存入 Keychain
# 切勿将真实 API Key 写入此文件后提交到 Git

# Codex API Key（示例）
CODEX_API_KEY=your_codex_api_key_here

# MiniMax API Key（示例）
MINIMAX_API_KEY=your_minimax_api_key_here

# DeepSeek API Key（示例）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
